      "additionalProperties": false,
      "description": "Set (or clear with `quarters: null`) a score in quarter points.",
      "properties": {
        "asParticipantId": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
