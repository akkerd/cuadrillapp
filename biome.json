{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dev-dist",
      "!**/test-results",
      "!**/playwright-report",
      "!apps/server",
      "!packages/protocol/schema.json",
      "!packages/protocol/src/generated.ts",
      "!packages/protocol/src/events.ts",
      "!packages/protocol/src/constants.ts",
      "!openspec",
      "!.agents",
      "!.claude"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
